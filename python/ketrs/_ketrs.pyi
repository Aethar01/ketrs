        ...

    @staticmethod
    def pauli(n_qubits: int, terms: Sequence[tuple[str, float]]) -> Channel:
        """Mixture of Pauli strings `[(label, prob), ...]`; identity gets the remaining weight."""
        ...

    @staticmethod
    def bit_flip(p: float) -> Channel:
