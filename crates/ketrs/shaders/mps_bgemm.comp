#version 460
// ketrs-variants: T = 8 16
// Grouped complex GEMM for block-sparse MPS contractions, in doubles: a
// list of independent products
//
//     C_t (= or +=) op(A_t) · op(B_t)
//
// in one dispatch. A, B and C are each one buffer (device addresses in the
// push constants); task t gives element offsets into them, its shape
// `m × k` by `k × n` and element strides (row, column) for A and B, and
// C's row stride (its columns are contiguous). `flags`, for the whole
// dispatch: bit 0 conjugates A, bit 1 conjugates B, bit 2 adds into C.
//
// Each T×T workgroup computes one T×T tile of one task, as listed in
// `tiles` (task, tile row, tile column): blocks of a symmetric MPS are
// small, so a whole contraction is many products, and tiles of 8 waste
// less of a small block than tiles of 16. The arithmetic is that of
// mps_gemm.comp (three real products per complex one).
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = T, local_size_y = T) in;

struct Task {
    uint a, b, c;
    uint m, n, k;
    uint a_row, a_col, b_row, b_col, c_row;
    uint pad;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer In { dvec2 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Out { dvec2 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Tasks { Task v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Tiles { uvec4 v[]; };

layout(push_constant) uniform Push {
    uvec2 a_addr, b_addr, c_addr, tasks_addr, tiles_addr;
    uint count, flags;
};

shared dvec3 as_[T][T + 1];
shared dvec3 bs[T][T + 1];

void main() {
    uint w = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (w >= count) {
        return;
    }
    uvec4 tile = Tiles(tiles_addr).v[w];
    Task t = Tasks(tasks_addr).v[tile.x];
    In a = In(a_addr);
    In b = In(b_addr);
    Out c = Out(c_addr);
    uint tx = gl_LocalInvocationID.x, ty = gl_LocalInvocationID.y;
    uint row0 = tile.y * T, col0 = tile.z * T;
    double a_sign = (flags & 1u) != 0u ? -1.0 : 1.0;
    double b_sign = (flags & 2u) != 0u ? -1.0 : 1.0;

    double t1 = 0.0, t2 = 0.0, t3 = 0.0;
    for (uint k0 = 0u; k0 < t.k; k0 += T) {
        uint ar = row0 + ty, ak = k0 + tx;
        dvec2 av = (ar < t.m && ak < t.k) ? a.v[t.a + ar * t.a_row + ak * t.a_col] : dvec2(0.0);
        av.y *= a_sign;
        as_[ty][tx] = dvec3(av, av.x + av.y);
        uint bk = k0 + ty, bc = col0 + tx;
        dvec2 bv = (bk < t.k && bc < t.n) ? b.v[t.b + bk * t.b_row + bc * t.b_col] : dvec2(0.0);
        bv.y *= b_sign;
        bs[ty][tx] = dvec3(bv, bv.x + bv.y);
        barrier();
        for (uint j = 0u; j < T; j++) {
            dvec3 x = as_[ty][j], y = bs[j][tx];
            t1 = fma(x.x, y.x, t1);
            t2 = fma(x.y, y.y, t2);
            t3 = fma(x.z, y.z, t3);
        }
        barrier();
    }
    uint row = row0 + ty, col = col0 + tx;
    if (row < t.m && col < t.n) {
        dvec2 acc = dvec2(t1 - t2, t3 - t1 - t2);
        uint at = t.c + row * t.c_row + col;
        c.v[at] = (flags & 4u) != 0u ? c.v[at] + acc : acc;
    }
}
