#version 460
// Batched complex GEMM for MPS contractions, in doubles:
//
//     C_b (= or +=) Σ_k op(A_b)[m, k] · op(B_b)[k, n]
//
// for every batch b. Operands are reached through device addresses with
// element strides (batch, row, column), so transposes are free and either
// operand may be shared (batch stride 0); `flags` bit 0 conjugates A, bit
// 1 conjugates B, bit 2 adds into C. C's columns are contiguous.
//
// The k range may be split `splits` ways (workgroup z = b · splits + s),
// each split writing its partial product `c_split` elements further on, to
// be summed by mps_sum: contractions over a long k (Σ over MPO channels)
// otherwise give too few output tiles to fill the GPU.
//
// Each 16×16 workgroup computes one 16×16 tile of C, one entry per thread,
// staging 16-wide k slices of A and B in shared memory. 64-bit floats run
// at a small fraction of the 32-bit rate on consumer GPUs, so this simple
// layout is already bound by them (it ran at the RX 9060 XT's double
// peak; larger per-thread tiles were slower).
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer In { dvec2 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Out { dvec2 v[]; };

layout(push_constant) uniform Push {
    uvec2 a_addr, b_addr, c_addr;
    uint m, n, k, splits;
    uint a_batch, a_row, a_col;
    uint b_batch, b_row, b_col;
    uint c_batch, c_row, c_split;
    uint flags;
};

const uint T = 16;
shared dvec2 as_[T][T + 1];
shared dvec2 bs[T][T + 1];

void main() {
    In a = In(a_addr);
    In b = In(b_addr);
    Out c = Out(c_addr);
    uint batch = gl_WorkGroupID.z / splits, split = gl_WorkGroupID.z % splits;
    uint k_len = (k + splits - 1u) / splits;
    uint k_begin = split * k_len, k_end = min(k, k_begin + k_len);
    uint tx = gl_LocalInvocationID.x, ty = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.y * T + ty, col = gl_WorkGroupID.x * T + tx;
    double a_sign = (flags & 1u) != 0u ? -1.0 : 1.0;
    double b_sign = (flags & 2u) != 0u ? -1.0 : 1.0;
    uint a_base = batch * a_batch, b_base = batch * b_batch;

    dvec2 acc = dvec2(0.0);
    for (uint k0 = k_begin; k0 < k_end; k0 += T) {
        // A tile: rows of this workgroup, k in [k0, k0 + T); thread (tx, ty)
        // loads A[row0 + ty][k0 + tx]. B tile: B[k0 + ty][col0 + tx].
        uint ar = gl_WorkGroupID.y * T + ty, ak = k0 + tx;
        dvec2 av = (ar < m && ak < k_end) ? a.v[a_base + ar * a_row + ak * a_col] : dvec2(0.0);
        as_[ty][tx] = dvec2(av.x, a_sign * av.y);
        uint bk = k0 + ty, bc = gl_WorkGroupID.x * T + tx;
        dvec2 bv = (bk < k_end && bc < n) ? b.v[b_base + bk * b_row + bc * b_col] : dvec2(0.0);
        bs[ty][tx] = dvec2(bv.x, b_sign * bv.y);
        barrier();
        for (uint j = 0u; j < T; j++) {
            dvec2 x = as_[ty][j], y = bs[j][tx];
            acc.x = fma(x.x, y.x, fma(-x.y, y.y, acc.x));
            acc.y = fma(x.x, y.y, fma(x.y, y.x, acc.y));
        }
        barrier();
    }
    if (row < m && col < n) {
        uint at = batch * c_batch + split * c_split + row * c_row + col;
        c.v[at] = (flags & 4u) != 0u ? c.v[at] + acc : acc;
    }
}
