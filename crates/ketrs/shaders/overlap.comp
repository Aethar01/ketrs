#version 450
// ketrs-variants: CHUNKED = 0 1
//
// ⟨λ|G|ψ⟩ for a generator G = Π_c |1⟩⟨1|_c ⊗ (Pauli terms sharing X-mask a),
// with λ the partner state: over its share of basis states j whose control
// bits are all set, each workgroup sums conj(λ_j) c(j ⊕ a) ψ_{j⊕a}, with
// c(i) = Σₜ coeffₜ (−1)^|i ∧ zₜ|, and writes the sum to partial[c + group].
// b = number of terms; at `offset`, the control mask (as a double), then
// each term's z (as a double) and coefficient including iⁿʸ (complex).
// units = number of amplitudes.
#include "common.glsl"

layout(std430, set = 0, binding = 2) writeonly buffer Out { dvec2 partial[]; };

shared dvec2 sums[256];

void main() {
    uint x = pc.a, terms = pc.b;
    uint controls = uint(params[pc.offset]);
    dvec2 acc = dvec2(0.0);
    FOR_EACH_UNIT(j) {
        if ((j & controls) != controls) {
            continue;
        }
        uint i = j ^ x;
        dvec2 c = dvec2(0.0);
        for (uint t = 0u; t < terms; t++) {
            uint p = pc.offset + 1u + 3u * t;
            dvec2 coeff = dvec2(params[p + 1u], params[p + 2u]);
            c += parity(i & uint(params[p])) == 1u ? -coeff : coeff;
        }
        dvec2 lambda = load_partner(j);
        acc += cmul(dvec2(lambda.x, -lambda.y), cmul(c, load_amp(i)));
    }
    uint lane = gl_LocalInvocationID.x;
    sums[lane] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) {
            sums[lane] += sums[lane + s];
        }
        barrier();
    }
    if (lane == 0u) {
        partial[pc.c + gl_WorkGroupID.x] = sums[0];
    }
}
