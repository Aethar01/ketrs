#version 450
// ketrs-variants: CHUNKED = 0 1
// ketrs-variants: SINGLE = 0 1
// ketrs-variants: TILE_BITS = 10 11 12
//
// The GPU's cache blocking: a run of gates that together act on at most
// TILE_BITS qubits, applied tile by tile in workgroup shared memory, so the
// whole run costs one pass over GPU memory.
//
// A tile is the 2^TILE_BITS amplitudes that differ only in the qubits of
// mask b (TILE_BITS of the c qubits in the state); `units` tiles cover the
// state, one workgroup each. a = number of gates. Gates use positions within
// the tile: tile bit j is the j-th lowest qubit in b.
//
// The gate list starts at `offset` in the parameter buffer. Each gate is an
// opcode followed by its integers (as doubles) and its numbers:
//   0 pair:  target, control mask, then m00 m01 m10 m11 (complex)
//   1 quad:  q0, q1, min(q0, q1), then 16 complex entries, row-major
//   2 pauli: x mask, z mask, highest bit of x, then cos, factor (complex)
//   3 phase: z mask, then plus, minus (complex)
//   4 diagonal pair: target, control mask, then d0 d1 (complex)
//   5 antidiagonal pair: target, control mask, 1 if a plain swap (X), then
//     m01 m10 (complex)
//   6 real pair: target, control mask, then m00 m01 m10 m11 (real)
//   7 swap:  q0, q1, min(q0, q1)
//
// Controlled gates loop over only the amplitudes with every control set,
// so no lane idles on an unmet control: GPUs without fast 64-bit floats are
// limited by this arithmetic, not by memory. The diagonal, antidiagonal,
// real and swap forms skip the multiplies a general matrix would need.
#include "common.glsl"

const uint TILE = 1u << TILE_BITS;
shared cplx tile[TILE];

// k with a zero bit inserted at each set bit of `mask`, lowest first.
uint insert_zero_bits(uint k, uint mask) {
    while (mask != 0u) {
        k = insert_zero_bit(k, uint(findLSB(mask)));
        mask &= mask - 1u;
    }
    return k;
}

cplx cat(uint p) {
    return cplx(param(p), param(p + 1u));
}

// Parallel bit deposit: the low bits of `src` placed, in order, at the set
// bits of `mask`.
uint deposit(uint src, uint mask) {
    uint out_bits = 0u;
    for (uint bit = 1u; mask != 0u; bit <<= 1u) {
        uint lowest = mask & (~mask + 1u);
        if ((src & bit) != 0u) {
            out_bits |= lowest;
        }
        mask &= mask - 1u;
    }
    return out_bits;
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint inside = pc.b;
    uint outside = (pc.c >= 32u ? 0xffffffffu : (1u << pc.c) - 1u) & ~inside;
    for (uint t = gl_WorkGroupID.x; t < pc.units; t += gl_NumWorkGroups.x) {
        uint base = deposit(t, outside);
        for (uint i = lane; i < TILE; i += 256u) {
            tile[i] = load_amp(base | deposit(i, inside));
        }
        barrier();

        uint p = pc.offset;
        for (uint g = 0u; g < pc.a; g++) {
            uint kind = param_uint(p);
            if (kind == 0u || kind == 5u || kind == 6u) {
                uint target = param_uint(p + 1u), control = param_uint(p + 2u);
                uint set_bits = control | (1u << target);
                uint pairs = TILE >> uint(bitCount(set_bits));
                if (kind == 0u) {
                    cplx m00 = cat(p + 3u), m01 = cat(p + 5u), m10 = cat(p + 7u), m11 = cat(p + 9u);
                    for (uint k = lane; k < pairs; k += 256u) {
                        uint i0 = insert_zero_bits(k, set_bits) | control;
                        uint i1 = i0 | (1u << target);
                        cplx x = tile[i0], y = tile[i1];
                        tile[i0] = cmul(m00, x) + cmul(m01, y);
                        tile[i1] = cmul(m10, x) + cmul(m11, y);
                    }
                    p += 11u;
                } else if (kind == 5u) {
                    bool plain = param_uint(p + 3u) == 1u;
                    cplx m01 = cat(p + 4u), m10 = cat(p + 6u);
                    for (uint k = lane; k < pairs; k += 256u) {
                        uint i0 = insert_zero_bits(k, set_bits) | control;
                        uint i1 = i0 | (1u << target);
                        cplx x = tile[i0], y = tile[i1];
                        tile[i0] = plain ? y : cmul(m01, y);
                        tile[i1] = plain ? x : cmul(m10, x);
                    }
                    p += 8u;
                } else {
                    real m00 = param(p + 3u), m01 = param(p + 4u), m10 = param(p + 5u), m11 = param(p + 6u);
                    for (uint k = lane; k < pairs; k += 256u) {
                        uint i0 = insert_zero_bits(k, set_bits) | control;
                        uint i1 = i0 | (1u << target);
                        cplx x = tile[i0], y = tile[i1];
                        tile[i0] = m00 * x + m01 * y;
                        tile[i1] = m10 * x + m11 * y;
                    }
                    p += 7u;
                }
            } else if (kind == 4u) {
                uint target = param_uint(p + 1u), control = param_uint(p + 2u);
                cplx d0 = cat(p + 3u), d1 = cat(p + 5u);
                uint count = TILE >> uint(bitCount(control));
                for (uint k = lane; k < count; k += 256u) {
                    uint i = insert_zero_bits(k, control) | control;
                    tile[i] = cmul((i >> target & 1u) == 1u ? d1 : d0, tile[i]);
                }
                p += 7u;
            } else if (kind == 7u) {
                uint q0 = param_uint(p + 1u), q1 = param_uint(p + 2u), low = param_uint(p + 3u);
                uint high = q0 + q1 - low;
                for (uint k = lane; k < TILE / 4u; k += 256u) {
                    uint b = insert_zero_bit(insert_zero_bit(k, low), high);
                    uint i01 = b | (1u << q0), i10 = b | (1u << q1);
                    cplx x = tile[i01];
                    tile[i01] = tile[i10];
                    tile[i10] = x;
                }
                p += 4u;
            } else if (kind == 1u) {
                uint q0 = param_uint(p + 1u), q1 = param_uint(p + 2u), low = param_uint(p + 3u);
                uint high = q0 + q1 - low;
                uint m = p + 4u;
                for (uint k = lane; k < TILE / 4u; k += 256u) {
                    uint b = insert_zero_bit(insert_zero_bit(k, low), high);
                    uint idx[4] = uint[4](b, b | (1u << q0), b | (1u << q1), b | (1u << q0) | (1u << q1));
                    cplx v[4] = cplx[4](tile[idx[0]], tile[idx[1]], tile[idx[2]], tile[idx[3]]);
                    for (uint r = 0u; r < 4u; r++) {
                        cplx acc = cplx(0.0);
                        for (uint c = 0u; c < 4u; c++) {
                            acc += cmul(cat(m + 8u * r + 2u * c), v[c]);
                        }
                        tile[idx[r]] = acc;
                    }
                }
                p += 36u;
            } else if (kind == 2u) {
                uint x = param_uint(p + 1u), z = param_uint(p + 2u), high = param_uint(p + 3u);
                real cs = param(p + 4u);
                cplx f = cat(p + 5u);
                for (uint k = lane; k < TILE / 2u; k += 256u) {
                    uint j = insert_zero_bit(k, high);
                    uint jp = j ^ x;
                    cplx a = tile[j], b = tile[jp];
                    cplx fj = parity(jp & z) == 1u ? -f : f;
                    cplx fjp = parity(j & z) == 1u ? -f : f;
                    tile[j] = cs * a + cmul(fj, b);
                    tile[jp] = cs * b + cmul(fjp, a);
                }
                p += 7u;
            } else {
                uint z = param_uint(p + 1u);
                cplx plus = cat(p + 2u), minus = cat(p + 4u);
                for (uint i = lane; i < TILE; i += 256u) {
                    tile[i] = cmul(parity(i & z) == 1u ? minus : plus, tile[i]);
                }
                p += 6u;
            }
            barrier();
        }

        for (uint i = lane; i < TILE; i += 256u) {
            store_amp(base | deposit(i, inside), tile[i]);
        }
        barrier();
    }
}
