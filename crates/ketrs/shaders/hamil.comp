#version 450
// ketrs-variants: CHUNKED = 0 1
// ketrs-variants: SINGLE = 0 1
//
// partner = H ψ for a Pauli sum H in b groups of terms sharing an X-mask:
// (Hψ)_j = Σ_groups c(j ⊕ x) ψ_{j⊕x}, c(i) = Σₜ coeffₜ (−1)^|i ∧ zₜ|. At
// `offset`, each group is x and its number of terms (as doubles), then each
// term's z (as a double) and coefficient including iⁿʸ (complex).
// units = number of amplitudes.
#include "common.glsl"

void main() {
    uint groups = pc.b;
    FOR_EACH_UNIT(j) {
        cplx acc = cplx(0.0);
        uint p = pc.offset;
        for (uint g = 0u; g < groups; g++) {
            uint x = param_uint(p);
            uint terms = param_uint(p + 1u);
            p += 2u;
            uint i = j ^ x;
            cplx c = cplx(0.0);
            for (uint t = 0u; t < terms; t++) {
                cplx coeff = cplx(param(p + 1u), param(p + 2u));
                c += parity(i & param_uint(p)) == 1u ? -coeff : coeff;
                p += 3u;
            }
            acc += cmul(c, load_amp(i));
        }
        store_partner(j, acc);
    }
}
